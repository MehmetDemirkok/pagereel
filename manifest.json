{
  "manifest_version": 3,
  "name": "PageReel — Full Page Screenshot",
  "short_name": "PageReel",
  "version": "1.1.1",
  "description": "Capture an entire scrolling webpage as one clean image. One click, no login, sticky headers handled automatically.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "PageReel — capture the whole page"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "offscreen",
    "storage"
  ],
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Capture the full page"
    }
  },
  "minimum_chrome_version": "116"
}
